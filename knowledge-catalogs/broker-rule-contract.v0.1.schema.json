{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/policy-comparison/broker-rule-contract.v0.1.schema.json",
  "title": "BrokerRule candidate and approval contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleId",
    "catalogId",
    "version",
    "status",
    "comparisonPointId",
    "ruleType",
    "autoScoreAllowed",
    "operator",
    "applicability",
    "evidence",
    "approval",
    "missingFactBehavior",
    "conflictBehavior",
    "tests"
  ],
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "approved", "suspended", "retired"]
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "changeReason": {
      "type": "string"
    },
    "comparisonPointId": {
      "type": "string",
      "minLength": 1
    },
    "expectedFactRoles": {
      "type": "array",
      "items": {
        "enum": [
          "coverage",
          "insured_object",
          "definition",
          "limit",
          "deductible",
          "condition",
          "exclusion",
          "obligation",
          "duration",
          "premium"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ruleType": {
      "enum": [
        "hard_comparability_gate",
        "directional_preference",
        "threshold",
        "red_flag",
        "advisory",
        "manual_only"
      ]
    },
    "autoScoreAllowed": {
      "const": false,
      "description": "Pilot default. A future schema version and explicit approval are required before automatic scoring."
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "factRole"],
      "properties": {
        "kind": {
          "enum": ["higher", "lower", "boolean", "range", "presence", "manual"]
        },
        "factRole": {
          "type": "string"
        },
        "unit": {
          "type": ["string", "null"]
        },
        "currency": {
          "type": ["string", "null"]
        },
        "basis": {
          "type": ["string", "null"]
        },
        "period": {
          "type": ["string", "null"]
        },
        "aggregation": {
          "type": ["string", "null"]
        },
        "threshold": {}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["jurisdiction", "validFrom"],
      "properties": {
        "jurisdiction": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "productScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customerType": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buildingProfileRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validTo": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": ["string", "null"]
        },
        "weight": {
          "type": ["number", "null"]
        },
        "sensitivityRequired": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceType",
          "publisher",
          "reference",
          "retrievedAt",
          "evidenceGrade"
        ],
        "properties": {
          "sourceType": {
            "enum": [
              "primary_law",
              "official_dataset",
              "broker_guideline",
              "market_evidence",
              "expert_approval"
            ]
          },
          "publisher": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": ["string", "null"],
            "format": "date"
          },
          "effectiveTo": {
            "type": ["string", "null"],
            "format": "date"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date"
          },
          "evidenceGrade": {
            "enum": ["primary", "approved_expert", "measured", "unvalidated"]
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRole", "approvedBy", "approvedAt", "reviewDueAt"],
      "properties": {
        "requiredRole": {
          "type": "string"
        },
        "approvedBy": {
          "type": ["string", "null"]
        },
        "approvedAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "reviewDueAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "fourEyesRequired": {
          "type": "boolean"
        }
      }
    },
    "knownExceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingFactBehavior": {
      "const": "not_evaluable"
    },
    "conflictBehavior": {
      "const": "unresolved"
    },
    "resultLabels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "expected"],
        "properties": {
          "caseId": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    }
  }
}
